{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cezar",
  "version": "0.11.1",
  "identifier": "com.openmercato.cezar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local cockpit for AI coding agents",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
